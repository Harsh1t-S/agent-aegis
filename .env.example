# Set these on the backend (aegis-api), never as VITE_ variables.
AIROUTER_API_KEY=
LLM_MODEL=airouter:openai/gpt-5.6-luna-fast
LLM_FALLBACK_MODELS=groq:openai/gpt-oss-20b,google:gemini-flash-lite-latest
LLM_MAX_OUTPUT_TOKENS=2048
GROQ_API_KEY=
GOOGLE_API_KEY=
# Use a separate random owner key. Enter it in Settings to unlock this browser tab.
# Required for all writes and paid execution on Vercel; saved reports remain public.
AEGIS_ADMIN_KEY=

# Local development. Production must keep its existing persistent DATABASE_URL.
DATABASE_URL=sqlite:///./evaluator.db
MOCK_INLINE=1
MOCK_TOOL_URL=http://localhost:8001
MAX_STEPS=12
MAX_TOOL_CALLS=10
MAX_WALL_SECONDS=45

# Vercel sets serverless flags automatically; retain the persistent database URL.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres
