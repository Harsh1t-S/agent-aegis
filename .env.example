# Local development
DATABASE_URL=sqlite:///./evaluator.db
MOCK_TOOL_URL=http://localhost:8001
MAX_STEPS=12
MAX_TOOL_CALLS=10
MAX_WALL_SECONDS=45

# Serverless (set these in the Vercel project's environment variables)
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres
# SERVERLESS=1
# MOCK_INLINE=1
# SYNC_RUNS=1
