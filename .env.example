# Database and runtime
DATABASE_URL=sqlite:///./evaluator.db
AEGIS_AUTH_DISABLED=1
AEGIS_AUTO_CREATE_SCHEMA=1
SYNC_RUNS=0
AEGIS_DURABLE_QUEUE=0
AEGIS_QUEUE_ALERT_SECONDS=300
MOCK_INLINE=1
MOCK_TOOL_URL=http://127.0.0.1:8001
MAX_STEPS=12
MAX_TOOL_CALLS=10
MAX_WALL_SECONDS=45

# Hosted identity (required when AEGIS_AUTH_DISABLED is not 1)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
AEGIS_API_KEY_PEPPER=
# Generate with: python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AEGIS_SECRET_ENCRYPTION_KEY=

# Evaluator model. Any OpenAI-compatible endpoint works. A deployment should pin
# one model for release evaluations; automatic fallbacks default to disabled.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=local-ollama
LLM_MODEL=qwen3.5:4b
LLM_FALLBACK_MODELS=
LLM_MAX_INPUT_TOKENS=16000
LLM_MAX_OUTPUT_TOKENS=1024
# Set to 0 for local inference. For an external provider, set a conservative
# per-scenario reserve; if omitted Aegis reserves $0.25 per scenario.
LLM_RESERVED_COST_PER_SCENARIO_USD=0
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# Optional external providers. These stay on the backend/worker.
AIROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Connected-agent outbound policy
AGENT_HTTP_ALLOWLIST=
AEGIS_ALLOW_INSECURE_AGENT_HTTP=0

# Razorpay subscriptions
APP_URL=http://localhost:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_TEAM_PLAN_ID=

# Completion/failure email (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aegis <evaluations@example.com>
