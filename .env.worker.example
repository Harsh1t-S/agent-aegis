# Use the direct or transaction-pooler Postgres URL used by the Aegis API.
# Keep this file outside source control as .env.worker.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres

# Optional stable label in job leases and logs.
WORKER_ID=my-gpu-worker
AEGIS_QUEUE_ALERT_SECONDS=300

# Must exactly match the backend value so the worker can decrypt runner tokens.
AEGIS_SECRET_ENCRYPTION_KEY=

# Override at launch with AEGIS_LOCAL_MODEL=qwen3.5:2b on lower-memory hardware.
AEGIS_LOCAL_MODEL=qwen3.5:4b
LLM_MAX_INPUT_TOKENS=16000
LLM_RESERVED_COST_PER_SCENARIO_USD=0

# Hugging Face ZeroGPU alternative (keep the token identical to the Space secret):
# LLM_BASE_URL=https://mrt0nystark-aegis-evaluator-model.hf.space/v1
# LLM_MODEL=Qwen/Qwen3.5-0.8B
# LLM_API_KEY=replace-with-a-long-random-space-token
# LLM_FALLBACK_MODELS=
# LLM_REQUEST_TIMEOUT_SECONDS=120

# Optional completion email. Use the same values on API and worker.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aegis <evaluations@example.com>
