# Where the browser should send API calls.
#
# Leave this unset in normal deployments: the default `/api` is served from the
# same origin (Vite proxies it in dev, a Vercel function proxies it in production),
# which avoids CORS entirely. Point it at an absolute origin only when running
# the frontend against an API that allows this origin.
# VITE_API_BASE_URL=/api

# Local development defaults to http://127.0.0.1:8000.
# AEGIS_API_ORIGIN=http://127.0.0.1:8000
# On Vercel Production, the backend origin defaults to the production API.
# On Vercel Preview, explicitly set AEGIS_API_ORIGIN to an isolated HTTPS backend.
# Preview requests are blocked if the origin is missing or points at production.
# Keep provider credentials and AEGIS_ADMIN_KEY on aegis-api only.
